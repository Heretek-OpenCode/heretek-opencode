{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node", "bun"]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packs/*/src/**/*",
    "packs/*/scripts/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
